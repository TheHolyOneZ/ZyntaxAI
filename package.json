{
  "name": "zyntax-ai",
  "version": "1.0.1",
  "private": true,
  "description": "ZyntaxAI \u2014 cross-platform AI writing assistant",
  "scripts": {
    "dev": "pnpm --filter @zyntax/desktop dev",
    "build": "pnpm --filter @zyntax/desktop build",
    "typecheck": "pnpm --filter @zyntax/desktop typecheck",
    "test": "pnpm --filter @zyntax/desktop test",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "release": "node scripts/release.mjs",
    "site:sync": "node scripts/site-sync.mjs",
    "rs:test": "cargo test --workspace",
    "rs:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rs:fmt": "cargo fmt --all"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0-or-later"
}
