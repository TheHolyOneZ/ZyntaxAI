{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZyntaxAI",
  "version": "1.0.1",
  "identifier": "dev.theholyonez.zyntaxai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ZyntaxAI",
        "url": "index.html",
        "width": 940,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true,
        "theme": null,
        "decorations": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "overlay",
        "title": "ZyntaxAI",
        "url": "overlay.html",
        "width": 560,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://zsync.eu/zyntaxai/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENDg5RDE5MTBDRDA0OEIKUldTTEJNMFFHWjFJYmVmVFRLNC9hM1hsUVkrdmUzQzNva0ZmS1dZeC90SkFhWTJIREw1VVhlbVAK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "TheHolyOneZ",
    "homepage": "https://zsync.eu/zyntaxai/",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright \u00a9 2026 TheHolyOneZ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "AI writing assistant",
    "longDescription": "Correct, rewrite and translate text in any application with a global hotkey. Works with Google Gemini, any OpenAI-compatible endpoint, or a local Ollama model that keeps your text on your own machine.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
